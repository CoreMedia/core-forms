{
  "name": "@coremedia-blueprint/studio-client.form-editor",
  "version": "1.0.0-SNAPSHOT",
  "dependencies": {
    "@coremedia/studio-client.cap-base-models": "catalog:",
    "@jangaroo/runtime": "catalog:"
  },
  "devDependencies": {
    "@jangaroo/build": "catalog:",

    "@jangaroo/core": "catalog:",
    "@coremedia/studio-client.ext.eslint-config": "catalog:",
    "eslint": "catalog:",

    "rimraf": "catalog:"
  },
  "scripts": {
    "clean": "rimraf ./dist && rimraf ./build",
    "build": "jangaroo build",
    "watch": "jangaroo watch",
    "lint": "eslint"
  },
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": false,
    "exports": {
      "./*": {
        "types": "./src/*.d.ts",
        "default": "./src/*.js"
      }
    }
  }
}
